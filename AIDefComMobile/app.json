{
  "expo": {
    "name": "AIDefComMobile",
    "slug": "AIDefComMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to microphone for voice recording and displaying audio levels during voice registration.",
        "LSApplicationQueriesSchemes": [
          "com.googleusercontent.apps.610663420023-dl82fv2cd71m1nqm5mivjq4mve19f2un"
        ]
      },
      "bundleIdentifier": "com.anonymous.AIDefComMobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.AIDefComMobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleWebClientId": "610663420023-dln5441dchtaue3abv4hiv9sak0f8v17.apps.googleusercontent.com",
      "googleIosClientId": "610663420023-dl82fv2cd71m1nqm5mivjq4mve19f2un.apps.googleusercontent.com",
      "googleAndroidClientId": "610663420023-dln5441dchtaue3abv4hiv9sak0f8v17.apps.googleusercontent.com",
      "eas": {
        "projectId": "2c439ff0-b047-441f-a41b-346f78c6abad"
      }
    },
    "scheme": "aidefcommobile",
    "plugins": [
      "expo-dev-client",
      "expo-web-browser",
      "./modules/audio-level-monitor/app.plugin.js",
      "expo-font",
      "expo-asset",
      "expo-audio"
    ]
  }
}
